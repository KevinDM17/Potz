diff --git a/cmd/arena/visor.go b/cmd/arena/visor.go
new file mode 100644
index 0000000..8c7fe98
--- /dev/null
+++ b/cmd/arena/visor.go
@@ -0,0 +1,52 @@
+package main
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"os"
+
+	"github.com/aicspucp/pokerfight-arena-participantes/internal/mesa"
+	"github.com/aicspucp/pokerfight-arena-participantes/internal/protocolo"
+)
+
+type eventoEnVivo struct {
+	Tipo      string                    `json:"tipo"`
+	Estado    protocolo.EstadoPublico   `json:"estado"`
+	Privadas  map[string]protocolo.Mano `json:"privadas,omitempty"`
+	Resultado *protocolo.ResultadoMano  `json:"resultado,omitempty"`
+}
+
+func observadorEnVivo(ctx context.Context, cancelar context.CancelFunc) mesa.ObservadorEstado {
+	avanzar := make(chan struct{})
+	go func() {
+		entrada := bufio.NewScanner(os.Stdin)
+		for entrada.Scan() {
+			if entrada.Text() == "avanzar" {
+				select {
+				case avanzar <- struct{}{}:
+				case <-ctx.Done():
+					return
+				}
+			}
+		}
+		cancelar()
+	}()
+
+	salida := json.NewEncoder(os.Stdout)
+	return func(estado protocolo.EstadoPublico, privadas map[string]protocolo.Mano, resultado *protocolo.ResultadoMano) {
+		if ctx.Err() != nil {
+			return
+		}
+		evento := eventoEnVivo{Tipo: "mesa_en_vivo", Estado: estado, Privadas: privadas, Resultado: resultado}
+		if salida.Encode(evento) != nil {
+			cancelar()
+			return
+		}
+		// Espera entre turnos, antes de que empiece el plazo de la próxima jugada.
+		select {
+		case <-avanzar:
+		case <-ctx.Done():
+		}
+	}
+}
